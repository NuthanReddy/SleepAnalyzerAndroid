<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Persist the Room database and user preferences so sleep history, notes,
         goals, and profile survive an app reinstall via Android Auto Backup.
         Large per-device audio captures are excluded to stay under the 25MB quota. -->
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <exclude domain="file" path="recordings/" />
</full-backup-content>